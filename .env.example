# Copy this file to .env and fill in the values. Never commit .env.
#
# BASE_URL is the HInsight backend (Go/Echo API). Pick the host for where the app runs:
#   Android emulator:            http://10.0.2.2:8080   (10.0.2.2 is your computer, seen from the emulator)
#   iOS simulator, web, desktop: http://localhost:8080
#   Physical phone:              http://<your computer's LAN IP>:8080   (same Wi-Fi as the computer)
#   Deployed backend:            the DigitalOcean URL from the backend team
BASE_URL=
